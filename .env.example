# OPC-玄机 本地/私有网络开发连接串（复制为 .env 后填写；.env 已在 .gitignore，禁止提交口令）
# 业务库
OPC_PG_DSN=postgresql://<db-user>:<db-password>@localhost:5432/opc
# 集成测试库（必须与业务库不同，测试会清空全部业务表）
OPC_TEST_DSN=postgresql://<db-user>:<db-password>@localhost:5432/opc_test
# 可选
# OPC_ARCHIVE_DIR=/path/to/opc-xuanji/archive
# OPC_TIMEZONE=Asia/Shanghai
