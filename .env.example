# OPC-玄机 本地/私有网络开发连接串（复制为 .env 后填写；.env 已在 .gitignore，禁止提交口令）
# 业务库
OPC_PG_DSN=postgresql://<db-user>:<db-password>@localhost:5432/opc
# 集成测试库（必须与业务库不同，测试会清空全部业务表）
OPC_TEST_DSN=postgresql://<db-user>:<db-password>@localhost:5432/opc_test
# 可选
# OPC_ARCHIVE_DIR=/path/to/opc-xuanji/archive
# OPC_TIMEZONE=Asia/Shanghai

# Super Agent 基础设施层（dsh-super-agents）面板地址，默认 http://127.0.0.1:3081
# OPC_SUPER_AGENTS_URL=http://127.0.0.1:3081

# Hindsight 记忆服务（记忆导入/同步页签用），内网默认 http://192.168.1.12:8888 / bank coding-agent::workspace
# OPC_HINDSIGHT_URL=http://192.168.1.12:8888
# OPC_HINDSIGHT_BANK=coding-agent::workspace

# 公司默认测试服务器（Debian + SSH，默认账号 canetwork）口令：只由环境注入，禁止提交明文
# OPC_DEFAULT_SSH_PASSWORD=

# SVN 检出（公司主用版本库）：需在检出主机安装 subversion ≥1.10；口令只经 env: 引用 + stdin 传入
# OPC_SVN_USERNAME=opc
# OPC_SVN_PASSWORD=

# 运维反馈：GitHub Issue 自动投递（未配置 token 时只攒草稿，不失败）
# OPC_GITHUB_TOKEN=
# OPC_GITHUB_REPO=mindtheory/opc-xuanji
# OPC_GITHUB_API_BASE=https://api.github.com
# OPC_GITHUB_LABELS=
# OPC_GITHUB_MAX_PER_RUN=5
# 运维反馈：AI 审视使用习惯（OpenAI 兼容端点；不配置则只走规则审视）
# OPC_AI_API_KEY=
# OPC_AI_BASE_URL=https://api.deepseek.com/v1
# OPC_AI_MODEL=deepseek-chat
# OPC_AI_DISABLED=0
